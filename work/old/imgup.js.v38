// ---- תמונה שלי לבגד: חיתוך אוטומטי של צילום מסך, היסטוריית תמונות, הדבקה, הודעת שמירה ברורה
document.head.insertAdjacentHTML('beforeend',`<style>
.imgrow{grid-column:1/-1;display:grid;gap:8px;background:var(--chip);border-radius:12px;padding:10px}
.imgrow .ib{display:flex;flex-wrap:wrap;gap:6px;align-items:center}.imgrow .ib>b{font-size:.9rem}
.imgrow button{font:inherit;font-size:.86rem;font-weight:600;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:99px;padding:7px 12px;cursor:pointer}
.imgrow .pz{flex:1 1 160px;min-height:38px;border:2px dashed var(--line);border-radius:10px;background:var(--card);color:var(--muted);font-size:.84rem;padding:8px 10px;outline:0;-webkit-user-select:text;user-select:text}
.imgrow .pz:focus{border-color:var(--accent);color:var(--fg)}
.imgrow .hist{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
.imgrow .hi{flex:none;width:76px;padding:0!important;border-radius:10px!important;overflow:hidden;position:relative;background:#fff!important}
.imgrow .hi img{width:100%;height:96px;object-fit:contain;display:block;background:#fff}
.imgrow .hi span{display:block;font-size:.66rem;padding:2px;background:var(--card);line-height:1.2}
.imgrow .hi.cur{outline:3px solid var(--accent);outline-offset:-3px}
.imgrow .pc{flex:none;display:flex;flex-direction:column;gap:3px;align-items:center}.imgrow .pa{display:flex;gap:2px}.imgrow .pa button{padding:3px 7px!important;font-size:.78rem!important}
.imgrow .seg2{display:inline-flex;gap:4px}.imgrow .seg2 button[aria-pressed="true"],.imgrow .pa button:active{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
.ph .npics{position:absolute;inset-block-start:36px;inset-inline-end:8px;background:rgba(255,255,255,.92);color:#2d211b;font-size:.7rem;font-weight:700;padding:2px 7px;border-radius:99px;box-shadow:0 1px 3px rgba(0,0,0,.15)}
body[data-size="s"] .ph .npics{inset-block-start:26px;font-size:.6rem}
.mwrap{position:relative;min-width:0}.mwrap img.main{display:block}
.camb{position:absolute;bottom:10px;inset-inline-end:10px;z-index:3;font:inherit;font-weight:700;font-size:.95rem;border:0;border-radius:99px;padding:10px 16px;background:var(--accent);color:var(--accent-fg);box-shadow:0 2px 10px #0005;cursor:pointer}
.imgrow .camb2{background:var(--accent);color:var(--accent-fg);border-color:var(--accent);font-size:1rem;padding:10px 18px;flex:1 1 auto}
.imgrow .st2:empty{display:none}.fin{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:2;font-size:0;pointer-events:auto;-webkit-appearance:none;appearance:none}.fin::-webkit-file-upload-button{width:100%;height:100%;cursor:pointer}.lbtn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:4px;font:inherit;font-size:.86rem;font-weight:600;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:99px;padding:7px 12px;cursor:pointer;-webkit-tap-highlight-color:transparent}.lbtn.go,.camb2{background:var(--accent)!important;color:var(--accent-fg)!important;border-color:var(--accent)!important}.camb{border:0;display:inline-flex;align-items:center;gap:4px;overflow:hidden}.lbtn{overflow:hidden}.imgrow details.mg{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:6px 10px}.imgrow details.mg summary{cursor:pointer;font-weight:700;font-size:.9rem;padding:4px 0}
.imgrow .ml2{display:grid;gap:6px;margin:6px 0}.imgrow .mr{display:grid;grid-template-columns:52px minmax(0,1fr);grid-template-areas:"i l" "i b";gap:2px 8px;align-items:center;border-bottom:1px solid var(--line);padding-bottom:6px}
.imgrow .mr img,.imgrow .mr .noimg{grid-area:i;width:52px;height:66px;object-fit:contain;background:#fff;border-radius:6px}.imgrow .mr .ml{grid-area:l;font-size:.84rem;font-weight:700}.imgrow .mr .mb{grid-area:b;display:flex;flex-wrap:wrap;gap:4px}
.imgrow .mr .mb button{padding:4px 9px;font-size:.78rem}.imgrow .mh{font-size:.84rem;margin-top:4px}.imgrow .go{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
.mwrap .gnav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:40px;height:40px;border-radius:50%;border:0;background:#fffe;color:#2d211b;font-size:1.6rem;line-height:1;box-shadow:0 2px 8px #0004;cursor:pointer}
.mwrap .gp{inset-inline-start:6px}.mwrap .gn{inset-inline-end:6px}.mwrap .gcap{position:absolute;top:8px;inset-inline:0;margin:auto;width:max-content;max-width:80%;z-index:3;background:#2d211bcc;color:#fff;font-size:.78rem;font-weight:700;padding:3px 10px;border-radius:99px}
.mwrap.avv img.main{background:linear-gradient(#fbf7f2,#efe6da)}
@media (max-width:560px){.dl{padding:14px;gap:12px}.imgrow{padding:8px}.imgrow .ib button{padding:7px 10px}}
.imgrow .st2{font-size:.86rem;font-weight:700}.imgrow .st2.busy{color:#7a5200}.imgrow .st2.ok{color:#256b2c}.imgrow .st2.err{color:#b4232f}
.ph .busyb,.dl .busyb{position:absolute;inset:auto 0 0 0;margin:auto;width:max-content;bottom:44px;background:#2d211bdd;color:#fff;font-size:.78rem;font-weight:700;padding:4px 10px;border-radius:99px;z-index:4}
</style>`);
const PREV={};const UPST={};
document.querySelectorAll('.grid .card').forEach(c=>{const im=c.querySelector('.ph img');c.dataset.orig=im?(im.dataset.th?'th':im.getAttribute('src')||''):''});
function origSrc(id){const c=card(id);const o=c&&c.dataset.orig;return (o&&o!='th'?o:'')||TH[id]||''}
// v27: the built-in thumbnail lives in a bundle (TH), not in the card's src, so "no image" is decided by D[id].hi, never by an empty src
paintImg=function(id){const c=card(id);if(!c)return;const it=IT[id]||{};const x=D[id]||{};const u=PREV[id]||(it.img?'/_blob/'+it.img:'');const ph=c.querySelector('.ph');let im=ph.querySelector('img');
 if(!u){if(x.hi||(c.dataset.orig&&c.dataset.orig!='th')){if(!im){ph.querySelector('.noimg')?.remove();im=document.createElement('img');im.alt='';im.loading='lazy';ph.prepend(im)}
   const t=c.dataset.orig&&c.dataset.orig!='th'?c.dataset.orig:(TH[id]||TPH);im.dataset.th=id;if(im.getAttribute('src')!=t)im.src=t;if(!TH[id]&&x.hi&&typeof thLoad=='function')thLoad(x.cat)}
  else if(im){im.remove();if(!ph.querySelector('.noimg'))ph.insertAdjacentHTML('afterbegin','<span class="noimg">אין תמונה</span>')}}
 else{if(!im){ph.querySelector('.noimg')?.remove();im=document.createElement('img');im.alt='';ph.prepend(im)}im.removeAttribute('data-th');if(im.getAttribute('src')!=u)im.src=u}
 ph.querySelector('.busyb')?.remove();ph.querySelector('.npics')?.remove();if((it.pics||[]).length)ph.insertAdjacentHTML('beforeend',`<span class="npics">📷 ${it.pics.length+1}</span>`);if(UPST[id]=='busy')ph.insertAdjacentHTML('beforeend','<span class="busyb">שומרת…</span>')};
// חיתוך: מוצא את הרצועה הגבוהה ביותר של שורות "תוכן" (לא פס אחיד של ממשק הטלפון), ואז מקצץ שוליים אחידים בצדדים
function flatLine(d,n,step){let s=0,s2=0,c=0,cr=0,cg=0,cb=0;const L=[];for(let i=0;i<n;i++){const k=i*step;const r=d[k],g=d[k+1],b=d[k+2];const y=.3*r+.59*g+.11*b;s+=y;s2+=y*y;L.push([r,g,b])}
 const mu=s/n,sd=Math.sqrt(Math.max(0,s2/n-mu*mu));L.sort((a,b)=>(a[0]+a[1]+a[2])-(b[0]+b[1]+b[2]));const md=L[n>>1];let near=0;for(const p of L)if(Math.abs(p[0]-md[0])+Math.abs(p[1]-md[1])+Math.abs(p[2]-md[2])<40)near++;
 return {flat:sd<9||near/n>.97,col:md}}
function bestRun(fl,minGap){const N=fl.length;let runs=[],st=-1;for(let i=0;i<=N;i++){const on=i<N&&!fl[i];if(on&&st<0)st=i;if(!on&&st>=0){runs.push([st,i]);st=-1}}
 const m=[];for(const r of runs){const p=m[m.length-1];if(p&&r[0]-p[1]<=minGap)p[1]=r[1];else m.push(r.slice())}
 return m.sort((a,b)=>(b[1]-b[0])-(a[1]-a[0]))[0]||null}
async function loadBitmap(f){if(window.createImageBitmap){try{return await createImageBitmap(f)}catch(_){}}return await new Promise((ok,no)=>{const u=URL.createObjectURL(f);const im=new Image();im.onload=()=>ok(im);im.onerror=no;im.src=u})}
async function autoCrop(file,nocrop){const bm=await loadBitmap(file);const W=bm.width,H=bm.height;const aw=Math.min(360,W),ah=Math.round(H*aw/W);
 const cv=document.createElement('canvas');cv.width=aw;cv.height=ah;const x=cv.getContext('2d',{willReadFrequently:true});x.drawImage(bm,0,0,aw,ah);const d=x.getImageData(0,0,aw,ah).data;
 const rows=[];for(let y=0;y<ah;y++)rows.push(flatLine(d.subarray(y*aw*4,(y+1)*aw*4),aw,4).flat);
 let r=bestRun(rows,Math.max(2,Math.round(ah*.006)));let y0=0,y1=ah,x0=0,x1=aw;
 if(r&&(r[1]-r[0])>ah*.2){y0=r[0];y1=r[1]}
 const cols=[];for(let i=0;i<aw;i++){const col=new Uint8ClampedArray((y1-y0)*4);for(let y=y0;y<y1;y++){const k=(y*aw+i)*4;col.set(d.subarray(k,k+4),(y-y0)*4)}cols.push(flatLine(col,y1-y0,4).flat)}
 const c=bestRun(cols,Math.max(2,Math.round(aw*.01)));if(c&&(c[1]-c[0])>aw*.3){x0=c[0];x1=c[1]}
 const sx=W/aw;let X0=Math.round(x0*sx),X1=Math.round(x1*sx),Y0=Math.round(y0*sx),Y1=Math.round(y1*sx);
 const cropped=!nocrop&&!((X1-X0)>W*.97&&(Y1-Y0)>H*.97);if(!cropped){X0=0;Y0=0;X1=W;Y1=H}
 const cw=X1-X0,ch=Y1-Y0,k=Math.min(1,1400/Math.max(cw,ch));const o=document.createElement('canvas');o.width=Math.round(cw*k);o.height=Math.round(ch*k);
 const ox=o.getContext('2d');ox.fillStyle='#fff';ox.fillRect(0,0,o.width,o.height);ox.drawImage(bm,X0,Y0,cw,ch,0,0,o.width,o.height);
 const blob=await new Promise(ok=>o.toBlob(b=>ok(b),'image/jpeg',.9));return {blob,cropped}}
function hist(id){return ((IT[id]||{}).imgs||[]).slice()}
async function upItemImg(id,file){if(!id||!file)return;if(UPST[id]=='busy'){toast('רגע, התמונה הקודמת עוד נשמרת');return}
 let a=null;try{a=await claude.use('assets')}catch(_){}if(!a){toast('העלאת תמונות לא זמינה כאן');setSt(id,'err','העלאת תמונות לא זמינה כאן');return}
 UPST[id]='busy';const prev=(IT[id]||{}).img||'';setSt(id,'busy','מסדרת את התמונה…');
 let out={blob:file,cropped:false};try{out=await autoCrop(file)}catch(_){}
 PREV[id]=URL.createObjectURL(out.blob);paintImg(id);showMain(id);setSt(id,'busy','שומרת…');
 try{const r=await a.upload(out.blob);const h=hist(id).filter(e=>e.id!=r.id);if(prev&&!h.some(e=>e.id==prev))h.unshift({id:prev,t:Date.now()-1});h.unshift({id:r.id,t:Date.now(),c:out.cropped?1:0});
  await putItem(id,{img:r.id,imgs:h.slice(0,12)});UPST[id]='';delete PREV[id];paintImg(id);showMain(id);setSt(id,'ok',out.cropped?'✓ נשמר. חתכתי את החלקים של הטלפון':'✓ התמונה נשמרה');toast('✓ התמונה נשמרה');
  if(out.cropped){try{const raw=await a.upload(file);const h2=hist(id);const i=h2.findIndex(e=>e.id==r.id);h2.splice(i+1,0,{id:raw.id,t:Date.now(),raw:1});await putItem(id,{imgs:h2.slice(0,12)});renderImgRow(id)}catch(_){}}}
 catch(e){UPST[id]='';delete PREV[id];paintImg(id);showMain(id);setSt(id,'err','לא הצלחתי לשמור. נסי שוב');toast('לא הצלחתי לשמור את התמונה')}}
function showMain(id){if(CUR!=id)return;GI[id]=0;const u=img(id);const im=$('#dlbody img.main');if(im&&u){if(im.getAttribute('src')!=u)im.src=u}else if(!im&&u){$('#dlbody').insertAdjacentHTML('afterbegin',`<img class="main" src="${u}" alt="">`)}renderImgRow(id)}
function setSt(id,k,msg){UPST[id+'_m']=[k,msg];const s=document.querySelector(`[data-imgrow="${id}"] .st2`);if(s){s.className='st2 '+k;s.textContent=msg}}
const GI={},MGO={};let MULTI=false;try{MULTI=localStorage.getItem('multi')=='1'}catch(_){}
document.addEventListener('change',e=>{const t=e.target;if(!t.matches||!t.matches('[data-multi]'))return;MULTI=t.checked;try{localStorage.setItem('multi',MULTI?'1':'0')}catch(_){}document.querySelectorAll('input.fin[data-addin]').forEach(i=>{if(MULTI)i.setAttribute('multiple','');else i.removeAttribute('multiple')})});let ZSAVED=0;const CANPASTE=!!(navigator.clipboard&&navigator.clipboard.read)&&(()=>{try{const fp=document.permissionsPolicy||document.featurePolicy;return fp?fp.allowsFeature('clipboard-read'):true}catch(_){return true}})();
document.addEventListener('change',e=>{const t=e.target;if(!t.matches||!t.matches('input.fin')||!t.files||!t.files.length)return;const fs=[...t.files];const id=t.dataset.camin||t.dataset.addin||t.dataset.p5in;t.value='';
 if(t.dataset.camin)addPics(id,fs,{label:'צילום שלי',nocrop:true});else if(t.dataset.addin)addPics(id,fs);else if(t.dataset.p5in)upP5(id,fs[0])});
const DSTK=[];{const sm=HTMLDialogElement.prototype.showModal;HTMLDialogElement.prototype.showModal=function(){const i=DSTK.indexOf(this);if(i>=0)DSTK.splice(i,1);DSTK.push(this);return sm.apply(this,arguments)}}
function topDlg(){for(let i=DSTK.length-1;i>=0;i--)if(DSTK[i].open)return DSTK[i];return [...document.querySelectorAll('dialog[open]')].pop()}
{const _t=toast;toast=function(m,u){const tt=$('#toast');const d=topDlg();if(tt){if(d&&tt.parentElement!==d)d.appendChild(tt);else if(!d&&tt.parentElement!==document.body)document.body.appendChild(tt)}return _t(m,u)}}

function galList(id){const it=IT[id]||{};const o=origSrc(id);const L=[];const m=it.img?'/_blob/'+it.img:o;if(m)L.push({u:m,n:'ראשית'});(it.pics||[]).forEach(p=>L.push({u:'/_blob/'+p.id,n:p.k||'גב'}));
 const p5=it.p5;if(p5&&typeof POSES!='undefined')POSES.forEach(([k,n])=>{if(p5[k])L.push({u:'/_blob/'+p5[k],n:'על האווטאר: '+n,av:1})});return L}
function paintGal(id){const w=$('#dlbody .mwrap');if(!w||CUR!=id)return;const L=galList(id);w.querySelectorAll('.gnav,.gcap').forEach(x=>x.remove());const im=w.querySelector('img.main');
 if(L.length<2){GI[id]=0;return}let i=Math.min(GI[id]||0,L.length-1);GI[id]=i;if(im&&!PREV[id])im.src=L[i].u;w.classList.toggle('avv',!!L[i].av);
 w.insertAdjacentHTML('beforeend',`<button class="gnav gp" data-gal="${id}" data-d="-1" aria-label="הקודמת">‹</button><button class="gnav gn" data-gal="${id}" data-d="1" aria-label="הבאה">›</button><span class="gcap">${esc(L[i].n)} · ${i+1}/${L.length}</span>`)}
function galStep(id,d){const L=galList(id);if(L.length<2)return;GI[id]=((GI[id]||0)+d+L.length)%L.length;paintGal(id)}
function renderImgRow(id){const el=document.querySelector(`[data-imgrow="${id}"]`);if(!el)return;
 if(!el.dataset.mv){el.dataset.mv=1;const im=$('#dlbody img.main');if(im){let t=im;while(t.parentElement&&t.parentElement.id!='dlbody')t=t.parentElement;if(t==im){const w=document.createElement('div');w.className='mwrap';im.before(w);w.appendChild(im);t=w}t.after(el);
  if(!t.querySelector('.camb'))t.insertAdjacentHTML('beforeend',`<button class="camb" data-upimg="${id}" data-upm="cam">📸 צלמי</button>`);
  let sx=null;t.addEventListener('touchstart',e=>{sx=e.touches[0].clientX},{passive:true});t.addEventListener('touchend',e=>{if(sx==null)return;const dx=e.changedTouches[0].clientX-sx;sx=null;if(Math.abs(dx)>40&&galList(id).length>1){e.stopPropagation();galStep(id,dx>0?1:-1)}})}}
 const it=IT[id]||{};const h=hist(id);const o=origSrc(id);const cur=it.img||'';const [k,msg]=UPST[id+'_m']||['',''];const ps=it.pics||[];
 const fd=t=>{const d=new Date(t);return isNaN(d)?'':`${d.getDate()}/${d.getMonth()+1}`};
 const row=(src,lab,btns)=>`<div class="mr">${src?`<img src="${src}" alt="" loading="lazy">`:'<span class="noimg">—</span>'}<span class="ml">${lab}</span><span class="mb">${btns}</span></div>`;
 const inPics=new Set(ps.map(p=>p.id));const old=h.filter(e=>e.id!=cur&&!inPics.has(e.id));
 let man='';
 man+=row(cur?'/_blob/'+cur:o,'⭐ ראשית'+(cur?'':' (המקורית)'),cur?`${o?`<button data-setimg="${id}" data-v="">↩ למקורית</button>`:''}<button data-delmain="${id}">🗑 מחקי</button>`:'');
 ps.forEach((p,i)=>{man+=row('/_blob/'+p.id,esc(p.k||'גב'),`<button data-piclab="${id}" data-i="${i}">🏷 שם</button><button data-picmain="${id}" data-i="${i}">⭐ ראשית</button><button data-picdel="${id}" data-i="${i}">🗑</button>`)});
 if(cur&&o&&!old.length)man+='';
 if(old.length||(cur&&o)){man+=`<b class="mh">תמונות קודמות</b>`;if(cur&&o)man+=row(o,'המקורית',`<button data-setimg="${id}" data-v="">↩ החזירי</button>`);old.forEach(e=>{man+=row('/_blob/'+e.id,(e.raw?'לא חתוכה':'שלי')+' '+fd(e.t),`<button data-setimg="${id}" data-v="${e.id}">↩ החזירי</button><button data-histdel="${id}" data-v="${e.id}">🗑</button>`)})}
 const n=1+ps.length;
 el.innerHTML=`${$('#dlbody .camb')?'':`<div class="ib"><button class="camb2" data-upimg="${id}" data-upm="cam">📸 צלמי עכשיו</button></div>`}
 <div class="ib"><button class="go" data-upimg="${id}" data-upm="add">➕ הוסיפי תמונה</button><button data-upimg="${id}" data-upm="main">⭐ החליפי ראשית</button>${CANPASTE?`<button data-pasteimg="${id}">📋 הדביקי</button>`:''}</div>
 <div class="pastebox" contenteditable="true" inputmode="none" data-ph="📋 לחיצה ארוכה כאן ← הדבק (אחרי שהעתקת תמונה)" style="border:2px dashed var(--line,#c9b8a6);border-radius:12px;padding:12px;margin:6px 0;min-height:22px;text-align:center;font-size:.9rem;opacity:.85"></div>
 <span class="st2 ${k}">${esc(msg)}</span><small style="opacity:.5">גרסה ${IMGUP_VER}</small>
 <small>צילום מסך נחתך לבד. אפשר להוסיף עוד תמונה אחרי תמונה (גב, צד).</small>
 <details class="mg" data-mg="m" ${MGO[id+'m']?'open':''}><summary>✏️ סידור ומחיקה (${n})</summary><div class="ml2">${man}</div>
  <div class="pz" contenteditable="true" data-pz="${id}" inputmode="none">לחיצה ארוכה כאן ← "הדבק" (אם הכפתור לא עובד)</div></details>
 <details class="mg" data-mg="p" ${MGO[id+'p']?'open':''}><summary>🧍 5 תנוחות על האווטאר${it.p5?' ✓':''}</summary><div class="p5slot"></div></details>`;
 el.querySelectorAll('details.mg').forEach(d=>d.addEventListener('toggle',()=>{MGO[id+d.dataset.mg]=d.open}));
 paintGal(id)}
document.addEventListener('click',async e=>{const t=e.target.closest('[data-setimg],[data-pasteimg],[data-addpics],[data-viewpic],[data-piclab],[data-picmain],[data-picdel],[data-pzt],[data-cam],[data-gal],[data-delmain],[data-histdel]');if(!t)return;e.preventDefault();e.stopPropagation();
 if(t.dataset.setimg){const id=t.dataset.setimg,v=t.dataset.v||'';const it=IT[id]||{};if((it.img||'')==v)return;const h=hist(id);if(it.img&&!h.some(e=>e.id==it.img))h.unshift({id:it.img,t:Date.now()});
  await putItem(id,{img:v||null,imgs:h.slice(0,12)});paintImg(id);showMain(id);setSt(id,'ok',v?'✓ חזרתי לתמונה הזו':'✓ חזרתי לתמונה המקורית');toast(v?'✓ התמונה הוחלפה':'✓ חזרתי לתמונה המקורית');return}
 if(t.dataset.addpics!==undefined&&t.dataset.addpics){const id=t.dataset.addpics;const f=$('#picfiles');f.dataset.id=id;f.click();return}
 if(t.dataset.gal){galStep(t.dataset.gal,+t.dataset.d);return}
 if(t.dataset.delmain){const id=t.dataset.delmain;const it=IT[id]||{};const h=hist(id).filter(e=>e.id!=it.img);const ps=(it.pics||[]).slice();let nm=null;if(!origSrc(id)&&ps.length){nm=ps.shift().id}await putItem(id,{img:nm,imgs:h,pics:ps});GI[id]=0;paintImg(id);showMain(id);setSt(id,'ok','✓ התמונה נמחקה. אפשר ללחוץ ביטול למטה');return}
 if(t.dataset.histdel){const id=t.dataset.histdel,v=t.dataset.v;await putItem(id,{imgs:hist(id).filter(e=>e.id!=v)});renderImgRow(id);setSt(id,'ok','✓ נמחקה');return}
 if(t.dataset.cam){const f=$('#camfile');f.dataset.id=t.dataset.cam;f.click();return}
 if(t.dataset.pzt){PZT[t.dataset.pzt]=t.dataset.v;renderImgRow(t.dataset.pzt);return}
 if(t.dataset.viewpic){const im=$('#dlbody img.main');if(im)im.src=t.dataset.u;t.closest('.pics').querySelectorAll('.hi').forEach(b=>b.classList.toggle('cur',b==t));im?.scrollIntoView({block:'nearest',behavior:'smooth'});return}
 if(t.dataset.piclab){const id=t.dataset.piclab,i=+t.dataset.i;const ps=((IT[id]||{}).pics||[]).map(p=>({...p}));const L=PICLABS;ps[i].k=L[(L.indexOf(ps[i].k||'גב')+1)%L.length];await putItem(id,{pics:ps});renderImgRow(id);return}
 if(t.dataset.picmain){const id=t.dataset.picmain,i=+t.dataset.i;const it=IT[id]||{};const ps=(it.pics||[]).map(p=>({...p}));const p=ps.splice(i,1)[0];if(it.img)ps.unshift({id:it.img,k:'קדימה',t:Date.now()});const h=hist(id);if(!h.some(e=>e.id==p.id))h.unshift({id:p.id,t:Date.now()});await putItem(id,{img:p.id,pics:ps,imgs:h.slice(0,12)});paintImg(id);showMain(id);setSt(id,'ok','✓ זו עכשיו התמונה הראשית');return}
 if(t.dataset.picdel){const id=t.dataset.picdel,i=+t.dataset.i;const ps=((IT[id]||{}).pics||[]).slice();const p=ps.splice(i,1)[0];const h=hist(id);if(p&&!h.some(e=>e.id==p.id))h.push({id:p.id,t:p.t||Date.now()});await putItem(id,{pics:ps,imgs:h.slice(0,12)});paintImg(id);showMain(id);setSt(id,'ok','✓ הוסר (נשאר בתמונות הקודמות)');return}
 if(t.dataset.pasteimg){const id=t.dataset.pasteimg;try{const its=await navigator.clipboard.read();for(const ci of its){const ty=ci.types.find(x=>x.startsWith('image/'));if(ty){const b=await ci.getType(ty);pasteTo(id,[new File([b],'paste.'+ty.split('/')[1],{type:ty})]);return}}setSt(id,'err','אין תמונה בהעתקה. העתיקי תמונה ונסי שוב');toast('אין תמונה בהעתקה')}catch(_){setSt(id,'err','ההדבקה מהכפתור חסומה כאן. פתחי "סידור ומחיקה", לחיצה ארוכה על המסגרת ← "הדבק"');toast('ההדבקה מהכפתור חסומה כאן')}}},true);
document.addEventListener('paste',e=>{const dlg=$('#dlg');if(!dlg||!dlg.open||!CUR)return;const fs=[...(e.clipboardData?.items||[])].filter(i=>i.kind=='file'&&i.type.startsWith('image/'));
 if(fs.length){e.preventDefault();pasteTo(CUR,fs.map(i=>i.getAsFile()))}else if(e.target.closest&&e.target.closest('[data-pz]')){e.preventDefault();toast('אין תמונה בהעתקה')}});
document.addEventListener('input',e=>{const z=e.target.closest&&e.target.closest('[data-pz]');if(!z)return;const im=z.querySelector('img');const id=z.dataset.pz;
 if(im&&im.src){fetch(im.src).then(r=>r.blob()).then(b=>{if(b.type.startsWith('image/'))pasteTo(id,[new File([b],'paste',{type:b.type})])}).catch(()=>toast('לא הצלחתי לקרוא את התמונה שהודבקה'))}z.textContent='או לחיצה ארוכה כאן ← "הדבק"'});
document.addEventListener('focusin',e=>{const z=e.target.closest&&e.target.closest('[data-pz]');if(z)z.textContent=''});
document.addEventListener('focusout',e=>{const z=e.target.closest&&e.target.closest('[data-pz]');if(z&&!z.textContent.trim())z.textContent='או לחיצה ארוכה כאן ← "הדבק"'});
const PZT={};const PICLABS=['גב','צד','פרט','קדימה','על הגוף','צילום שלי'];
document.body.insertAdjacentHTML('beforeend','<input type="file" id="picfiles" accept="image/*" multiple hidden>');
document.addEventListener('change',e=>{if(e.target.id!='picfiles'||!e.target.files.length)return;const fs=[...e.target.files];const id=e.target.dataset.id;e.target.value='';addPics(id,fs)});
function pasteTo(id,fs){addPics(id,fs)}
async function addPics(id,files,opt={}){if(!id||!files.length)return;if(!(IT[id]||{}).img&&!origSrc(id)){await upItemImg(id,files[0]);files=files.slice(1);if(!files.length)return}if(UPST[id]=='busy'){toast('רגע, התמונה הקודמת עוד נשמרת');return}
 let a=null;try{a=await claude.use('assets')}catch(_){}if(!a){toast('העלאת תמונות לא זמינה כאן');setSt(id,'err','העלאת תמונות לא זמינה כאן');return}
 UPST[id]='busy';let ok=0;const N=files.length;
 for(const f of files){setSt(id,'busy',N>1?`מסדרת ושומרת ${ok+1} מתוך ${N}…`:'מסדרת ושומרת…');let out={blob:f};try{out=await autoCrop(f,opt.nocrop)}catch(_){}
  try{const r=await a.upload(out.blob);const ps=((IT[id]||{}).pics||[]).slice();const used=ps.map(p=>p.k);const k=opt.label||PICLABS.find(l=>!used.includes(l))||'פרט';ps.push({id:r.id,k,t:Date.now()});await putItem(id,{pics:ps});ok++;renderImgRow(id);paintImg(id)}catch(_){}}
 UPST[id]='';paintImg(id);if(CUR==id){GI[id]=(IT[id].pics||[]).length;paintGal(id)}if(ok==N){setSt(id,'ok',N>1?`✓ נשמרו ${N} תמונות`:'✓ התמונה נוספה');toast(N>1?`✓ נשמרו ${N} תמונות`:'✓ התמונה נוספה');if(opt.nocrop&&CUR==id){const im=$('#dlbody img.main');const ps=(IT[id]||{}).pics||[];if(im&&ps.length)im.src='/_blob/'+ps[ps.length-1].id}}else{setSt(id,'err',`נשמרו ${ok} מתוך ${N}. נסי שוב את השאר`);toast('חלק מהתמונות לא נשמרו')}}
document.body.insertAdjacentHTML('beforeend','<input type="file" id="camfile" accept="image/*" hidden>');
document.addEventListener('change',e=>{if(e.target.id!='camfile'||!e.target.files.length)return;const f=e.target.files[0];const id=e.target.dataset.id;e.target.value='';addPics(id,[f],{label:'צילום שלי',nocrop:true})});
// ---- במסך ההגדלה: שמירת התמונה לטלפון (לחיפוש בשיין) ושיתוף
{const zb=document.querySelector('#zoomd .zb');if(zb){zb.insertAdjacentHTML('afterbegin',`<button data-zclean="1" title="מסך נקי לצילום מסך" aria-label="מסך נקי" style="width:auto;padding:0 12px;border-radius:99px;font-size:.9rem;font-weight:700">🫥 מסך נקי</button><button data-zsave="1" title="שמירה לטלפון" aria-label="שמירה לטלפון" style="width:auto;padding:0 14px;border-radius:99px;font-size:.95rem;font-weight:700">📥 שמירה</button>${navigator.canShare?'<button data-zshare="1" title="שיתוף" aria-label="שיתוף">📤</button>':''}`)}}
async function zoomBlob(){const im=document.querySelector('#zoomd img');if(!im||!im.src)throw 0;
 // מציירים ישר מהתמונה שכבר מוצגת (בלי fetch, שהאפליקציה חוסמת)
 if(!im.complete||!im.naturalWidth)await new Promise((ok,no)=>{im.onload=ok;im.onerror=no;setTimeout(no,5000)});
 const c=document.createElement('canvas');c.width=im.naturalWidth;c.height=im.naturalHeight;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0);
 let b=null;try{b=await new Promise(ok=>c.toBlob(ok,'image/jpeg',.93))}catch(_){}
 if(!b){const du=c.toDataURL('image/jpeg',.93);const bin=atob(du.split(',')[1]);const u8=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u8[i]=bin.charCodeAt(i);b=new Blob([u8],{type:'image/jpeg'})}
 if(!b)throw 0;return b}
function zoomName(){const id=CUR&&$('#dlg')?.open?CUR:'';return (id?(id+' '+((D[id]||{}).short||'').slice(0,30)):'בגד').replace(/[\\/:*?"<>|]/g,'').trim()+'.jpg'}
document.addEventListener('click',async e=>{const t=e.target.closest&&e.target.closest('[data-zsave],[data-zshare],[data-zclean]');if(!t)return;e.preventDefault();e.stopPropagation();const zh=document.querySelector('#zoomd .zh');const say=m=>{if(zh){zh.textContent=m;zh.style.color='#fff';zh.style.fontWeight='700'}};
 if(t.dataset.zclean){const zd=$('#zoomd');zd.classList.add('zclean');setTimeout(()=>zd.classList.remove('zclean'),6000);return}
 say('שומרת…');t.style.background='#b5562f';t.style.color='#fff';setTimeout(()=>{t.style.background='';t.style.color=''},1200);
 let b;try{b=await zoomBlob()}catch(err){say('לא הצלחתי להכין את התמונה. לחיצה ארוכה על התמונה ← "שמירת תמונה"');toast('לא הצלחתי להכין את התמונה');return}const name=zoomName();
 if(t.dataset.zshare){const f=new File([b],name,{type:'image/jpeg'});try{if(navigator.canShare({files:[f]})){await navigator.share({files:[f]});return}}catch(err){if(err&&err.name=='AbortError')return}}
 const fail=()=>{say('השמירה לא עובדת כאן. אפשר: "🫥 מסך נקי" ואז צילום מסך רגיל בטלפון, או לחיצה ארוכה על התמונה ← שמירת תמונה');};
 // קודם הורדה רגילה של הדפדפן (בלי הרשאות), ואז הכלי של האתר
 try{const u=URL.createObjectURL(b);const a=document.createElement('a');a.href=u;a.download=name;a.style.display='none';document.body.appendChild(a);a.click();setTimeout(()=>{a.remove();URL.revokeObjectURL(u)},4000);say('✓ נשמר בטלפון (בהורדות). בשיין: חיפוש לפי תמונה 📷');ZSAVED=1}catch(_){ZSAVED=0}
 let dl=null;try{dl=await Promise.race([claude.use('downloads'),new Promise(r=>setTimeout(()=>r(null),1500))])}catch(_){}
 if(ZSAVED){if(dl){try{await dl.save({filename:name,data:b})}catch(_){}}return}
 if(!dl){try{const f=new File([b],name,{type:'image/jpeg'});if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f]});say('✓ נשלח');return}}catch(err){if(err&&err.name=='AbortError'){say('בוטל');return}}fail();return}
 try{await dl.save({filename:name,data:b});say('✓ נשמר בטלפון (בהורדות). בשיין: חיפוש לפי תמונה 📷')}catch(err){if(err&&err.code=='declined')say('בוטל');else fail()}},true);
document.head.insertAdjacentHTML('beforeend','<style>#zoomd.zclean .zb,#zoomd.zclean .zh{display:none}</style>');
{const zd=document.querySelector('#zoomd');if(zd)zd.addEventListener('close',()=>{const zh=zd.querySelector('.zh');if(zh){zh.textContent='צביטה או גלגלת להגדלה · לחיצה כפולה מגדילה · גוררים כדי לזוז';zh.style.color='';zh.style.fontWeight=''}zd.classList.remove('zclean')})}

async function routeUp(id,f,mode){if(!f)return;if(mode=='p5')await upP5(id,f);else if(mode=='add')await addPics(id,[f]);else if(mode=='cam')await addPics(id,[f],{label:'צילום שלי',nocrop:true});else await upItemImg(id,f)}
const IMGUP_VER=28;
// ---- שם לחיפוש בטמו / שיין: שם הבגד ללא מילה חתוכה, העתקה ופתיחת חיפוש
function searchName(id){const x=D[id]||{};const t=((IT[id]||{}).tname||'').trim();return t||(x.full||x.short||'').trim()}
function copyTxt(txt){return (navigator.clipboard&&navigator.clipboard.writeText?navigator.clipboard.writeText(txt):Promise.reject()).catch(()=>{const ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();let ok=false;try{ok=document.execCommand('copy')}catch(_){}ta.remove();if(!ok)throw 0})}
function srchRowHTML(id){const n=searchName(id);const sh=(D[id].src||'')=='sh';const it=IT[id]||{};const q=encodeURIComponent(n);const url=sh?`https://il.shein.com/pdsearch/${q}/`:`https://www.temu.com/search_result.html?search_key=${q}`;
 return `<b>🔎 שם לחיפוש ב${sh?'שיין':'טמו'}:</b><div class="srchn" dir="rtl">${esc(n)}</div><div class="ib"><button data-cpn="${id}">📋 העתיקי שם</button><a class="lbtn" href="${sh?`https://il.shein.com/pdsearch/${q}/`:`https://www.temu.com/search_result.html?search_key=${q}`}" target="_blank" rel="noopener">🔎 חיפוש ב${sh?'שיין':'טמו'}</a><a class="lbtn alt" href="${sh?`https://www.temu.com/search_result.html?search_key=${q}`:`https://il.shein.com/pdsearch/${q}/`}" target="_blank" rel="noopener">🔎 חיפוש ב${sh?'טמו':'שיין'}</a></div>
 <small>מצאת תמונות נוספות של המוצר? שמרי אותן לטלפון והעלי כאן ב"📷 עוד תמונות" (גב / צד / פרט).</small>
 ${it.tname?`<small>✓ זה השם המדויק שהדבקת. <button class="lnk" data-tclr="${id}">מחקי</button></small>`:`<small>${sh?'זה השם מהחשבונית.':'זה השם כפי שמופיע בקבלה של טמו, שם הוא חתוך אחרי כ-45 אותיות, ולכן לפעמים לא מוצאים.'} אם יש לך את השם המלא מהאפליקציה, הדביקי אותו כאן:</small>`}
 <div class="ib"><input class="tname" dir="rtl" value="${esc(it.tname||'')}" placeholder="הדביקי כאן את השם המלא מ${sh?'שיין':'טמו'}"><button data-tsave="${id}">שמרי שם</button></div>`}
const _aoS=afterOpen;afterOpen=function(id){_aoS(id);const h3=$('#dlbody h3');if(!h3||$('#dlbody .srchrow'))return;if(!searchName(id))return;
 (h3.nextElementSibling&&h3.nextElementSibling.classList.contains('full')?h3.nextElementSibling:h3).insertAdjacentHTML('afterend',`<div class="srchrow" data-srch="${id}">${srchRowHTML(id)}</div>`)};
document.addEventListener('click',async e=>{const t=e.target.closest&&e.target.closest('[data-tsave],[data-tclr]');if(!t)return;e.preventDefault();e.stopPropagation();const id=t.dataset.tsave||t.dataset.tclr;const row=document.querySelector(`.srchrow[data-srch="${id}"]`);
 const v=t.dataset.tclr?'':(row.querySelector('.tname').value||'').trim();if(!t.dataset.tclr&&v.length<3){toast('הדביקי קודם את השם');return}
 await putItem(id,{tname:v});if(row)row.innerHTML=srchRowHTML(id);toast(v?'✓ השם המדויק נשמר, מעכשיו הוא זה שיועתק':'השם המדויק נמחק')},true);
document.addEventListener('click',async e=>{const b=e.target.closest&&e.target.closest('[data-cpn]');if(!b)return;e.preventDefault();e.stopPropagation();try{await copyTxt(searchName(b.dataset.cpn));toast('✓ השם הועתק. הדביקי בחיפוש')}catch(_){toast('לא הצלחתי להעתיק. אפשר ללחוץ ארוכות על השם ולהעתיק')}},true);
document.head.insertAdjacentHTML('beforeend','<style>.srchrow{margin:10px 0;padding:10px;background:var(--chip);border-radius:12px;display:grid;gap:6px}.srchn{font-weight:700;font-size:.95rem;background:var(--card);border-radius:8px;padding:8px 10px;-webkit-user-select:text;user-select:text;word-break:break-word}.srchrow .ib{display:flex;gap:6px;flex-wrap:wrap}.srchrow button,.srchrow a.lbtn{font:inherit;font-size:.86rem;font-weight:600;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:99px;padding:7px 12px;cursor:pointer;text-decoration:none;display:inline-flex}.srchrow small{color:var(--muted)}.srchrow .tname{flex:1 1 200px;font:inherit;font-size:16px;border:1px solid var(--line);border-radius:10px;padding:7px 10px;background:var(--card);color:var(--fg);min-width:0}.srchrow .lnk{border:0;background:none;color:var(--accent);text-decoration:underline;padding:0;font:inherit;font-size:inherit;cursor:pointer}</style>');

// v21: שדה בחירת קובץ אמיתי שקוף מעל כל כפתור העלאה, כך שהלחיצה בנייד פותחת את הגלריה ישירות
(function(){
 const st=document.createElement('style');st.textContent='button[data-upimg]{position:relative;overflow:hidden}button[data-upimg] input.ovf{position:absolute;inset:0;width:100%;height:100%;opacity:0;font-size:200px;cursor:pointer;margin:0;padding:0;border:0}';document.head.appendChild(st);
 function arm(){document.querySelectorAll('button[data-upimg]:not([data-armed])').forEach(b=>{
  b.dataset.armed='1';const inp=document.createElement('input');inp.type='file';inp.accept='image/*';inp.className='ovf';inp.tabIndex=-1;
  if(b.dataset.upm=='cam')inp.setAttribute('capture','environment');if(b.dataset.upm=='add')inp.multiple=true;
  const S=(k,m)=>{try{setSt(b.dataset.upimg,k,m)}catch(_){}};
  let done=false;
  const go=()=>{const f=inp.files&&inp.files[0];if(!f||done)return;done=true;try{localStorage.removeItem('upPend')}catch(_){}
   if(b.dataset.upm=='add'){const fs=[...inp.files];S('ok','');stage(b.dataset.upimg,fs);setTimeout(()=>{try{inp.value=''}catch(_){};done=false},1500);return}
   const up=document.getElementById('upfile');up.dataset.id=b.dataset.upimg;up.dataset.upm=b.dataset.upm||'main';
   try{const dt=new DataTransfer();dt.items.add(f);up.files=dt.files}catch(err){S('err','הטלפון לא מאפשר להעביר את הקובץ');return}
   S('busy','קיבלתי את התמונה ('+Math.round(f.size/1024)+' KB), מתחילה…');{const t0=Date.now(),id=b.dataset.upimg;let last='';const wd=setInterval(()=>{const m=(UPST[id+'_m']||[])[1]||'';const sec=Math.round((Date.now()-t0)/1000);if(sec>90||/^✓|לא הצלחתי|שגיאה/.test(m)){clearInterval(wd);return}if(!/^עדיין/.test(m))last=m;if(sec>=8)S('busy','עדיין עובדת ('+sec+' שנ׳) · שלב: '.concat(last))},4000)}
   up.dispatchEvent(new Event('change',{bubbles:true}));setTimeout(()=>{try{inp.value=''}catch(_){};done=false},3000)};
  inp.addEventListener('click',e=>{e.stopPropagation();done=false;S('busy','פותחת את הגלריה…');try{localStorage.setItem('upPend',JSON.stringify({id:b.dataset.upimg,t:Date.now()}))}catch(_){}
   let n=0;const poll=setInterval(()=>{n++;if(done||n>90){clearInterval(poll);return}if(inp.files&&inp.files[0]){clearInterval(poll);go()}},700)});
  inp.addEventListener('change',e=>{e.stopPropagation();go()});
  b.appendChild(inp)})}
 new MutationObserver(arm).observe(document.body,{childList:true,subtree:true});arm();
})();

// אם הטלפון סגר וטען מחדש את האתר בזמן בחירת התמונה
setTimeout(()=>{try{const p=JSON.parse(localStorage.getItem('upPend')||'null');if(!p)return;localStorage.removeItem('upPend');if(Date.now()-p.t>300000||!IT[p.id])return;openItem(p.id);setTimeout(()=>setSt(p.id,'err','הטלפון טען מחדש את האתר כשחזרת מהגלריה, והתמונה אבדה. נסי שוב'),600)}catch(_){}},2500);

{const st=document.createElement('style');st.textContent='.pastebox:empty:before{content:attr(data-ph)}';document.head.appendChild(st);document.addEventListener('input',e=>{if(e.target.classList&&e.target.classList.contains('pastebox'))setTimeout(()=>{e.target.innerHTML=''},50)})}

// v26: בחירת כמה תמונות יחד ושיוך כל אחת (ראשית / קדימה / צד / גב / פרט), עם ביטול
const STG_LABS=['ראשית','קדימה','צד','גב','פרט','לא לשמור'];
function stage(id,fs){
 // העתקה לזיכרון מיד כדי שהקבצים לא ייעלמו בנייד
 const d=topDlg()||document.body;d.querySelector('.stg')?.remove();
 const hasMain=!!((IT[id]||{}).img||origSrc(id));const defs=hasMain?['גב','צד','פרט','קדימה']:['ראשית','גב','צד','פרט'];
 const w=document.createElement('div');w.className='stg';w.dir='rtl';
 w.innerHTML=`<div class="stgh"><b>${fs.length>1?fs.length+' תמונות':'תמונה'} · בחרי מה כל תמונה</b><button class="stgx" data-stgx aria-label="ביטול">✕</button></div><div class="stgl">`+fs.map((f,i)=>`<div class="stgi"><img alt=""><select data-i="${i}">${STG_LABS.map(l=>`<option ${l==(defs[i]||'פרט')?'selected':''}>${l}</option>`).join('')}</select></div>`).join('')+`</div><div class="stgb"><button class="go" data-stgok>✓ שמרי</button><button data-stgx>ביטול</button></div>`;
 d.appendChild(w);const urls=[];w.querySelectorAll('.stgi img').forEach((im,i)=>{const u=URL.createObjectURL(fs[i]);urls.push(u);im.src=u});
 const close=()=>{w.remove();urls.forEach(u=>URL.revokeObjectURL(u))};
 w.addEventListener('click',async e=>{
  if(e.target.closest('[data-stgx]')){close();setSt(id,'ok','בוטל');return}
  if(e.target.closest('[data-stgok]')){const labs=[...w.querySelectorAll('select')].map(x=>x.value);close();
   const jobs=fs.map((f,i)=>({f,l:labs[i]})).filter(j=>j.l!='לא לשמור');if(!jobs.length){setSt(id,'ok','לא נשמר כלום');return}
   const mi=jobs.findIndex(j=>j.l=='ראשית');
   try{if(mi>=0){const m=jobs.splice(mi,1)[0];await upItemImg(id,m.f)}
    for(const j of jobs){await addPics(id,[j.f],{label:j.l=='ראשית'?'קדימה':j.l})}}catch(err){setSt(id,'err','שגיאה: '+(err&&err.message||err))}}})}
{const st=document.createElement('style');st.textContent='.stg{position:fixed;inset:0;z-index:99999;background:var(--bg,#fbf6ef);overflow:auto;padding:12px 14px 90px}.stgh{display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:var(--bg,#fbf6ef);padding:6px 0 10px}.stgx{width:44px;height:44px;border-radius:50%;border:0;font-size:1.3rem;background:#0001}.stgl{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stgi{display:flex;flex-direction:column;gap:6px}.stgi img{width:100%;aspect-ratio:1/1.1;object-fit:cover;border-radius:12px;background:#0001}.stgi select{font-size:1rem;padding:8px;border-radius:10px}.stgb{position:fixed;bottom:0;left:0;right:0;display:flex;gap:10px;padding:12px 14px;background:var(--bg,#fbf6ef);border-top:1px solid #0002}.stgb button{flex:1;padding:14px;font-size:1.05rem;border-radius:12px}#zoomd .zx2{position:absolute;top:10px;right:10px;z-index:5;width:46px;height:46px;border-radius:50%;border:0;font-size:1.4rem;background:#000a;color:#fff}#zoomd.zclean .zx2{display:none}';document.head.appendChild(st);
 const zd=document.querySelector('#zoomd');if(zd&&!zd.querySelector('.zx2')){const x=document.createElement('button');x.className='zx2';x.textContent='✕';x.setAttribute('aria-label','סגירה');x.onclick=()=>zd.close();zd.appendChild(x)}}
